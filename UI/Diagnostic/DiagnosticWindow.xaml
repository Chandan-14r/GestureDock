<Window x:Class="GestureDock.UI.Diagnostic.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestureDock Diagnostic &amp; Live Monitor"
        Width="580"
        Height="480"
        Background="#181818"
        Foreground="#FFFFFF">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Current Status -->
        <Border Grid.Row="0"
                Background="#222222"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Live State" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" Foreground="#4CC2FF"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Task View Active:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTvActive" Text="False" FontWeight="Bold" Foreground="#FF6B6B"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Foreground Window:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFgWindow" Text="N/A" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Window Class:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtFgClass" Text="N/A"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Overlay Visible:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtOverlayVisible" Text="False"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnTestShow" Content="Test Show Overlay" Padding="10,4" Margin="0,0,8,0" Click="BtnTestShow_Click"/>
            <Button x:Name="BtnTestHide" Content="Test Hide Overlay" Padding="10,4" Margin="0,0,8,0" Click="BtnTestHide_Click"/>
            <Button x:Name="BtnClearLog" Content="Clear Logs" Padding="10,4" Click="BtnClearLog_Click"/>
        </StackPanel>

        <!-- Event Log -->
        <TextBox Grid.Row="2"
                 x:Name="TxtLogs"
                 Background="#121212"
                 Foreground="#00FF66"
                 FontFamily="Consolas"
                 FontSize="11.5"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"/>
    </Grid>
</Window>
