<Window x:Class="GestureDock.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestureDock Settings"
        WindowStartupLocation="CenterScreen"
        Width="500"
        Height="540"
        ResizeMode="NoResize"
        Background="#181818"
        Foreground="#FFFFFF">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#4CC2FF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#2B88D8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="GestureDock Preferences"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"/>
            <TextBlock Text="Configure Task View companion overlay behavior"
                       FontSize="13"
                       Foreground="#888888"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General -->
                <GroupBox Header="General">
                    <StackPanel>
                        <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows"/>
                        <CheckBox x:Name="ChkEnableOverlay" Content="Enable Task View overlay"/>
                        <CheckBox x:Name="ChkEnableAnimations" Content="Enable smooth animations"/>
                    </StackPanel>
                </GroupBox>

                <!-- Overlay Position -->
                <GroupBox Header="Overlay Position">
                    <StackPanel>
                        <RadioButton x:Name="RbBottomRight" Content="Bottom Right (Recommended)" GroupName="Pos"/>
                        <RadioButton x:Name="RbBottomCenter" Content="Bottom Center" GroupName="Pos"/>
                        <RadioButton x:Name="RbBottomLeft" Content="Bottom Left" GroupName="Pos"/>
                    </StackPanel>
                </GroupBox>

                <!-- Close All Behavior -->
                <GroupBox Header="Close All Behavior">
                    <StackPanel>
                        <CheckBox x:Name="ChkConfirmClose" Content="Confirm before closing applications"/>
                        <CheckBox x:Name="ChkGracefulOnly" Content="Graceful close only (protect unsaved data)"/>
                        <CheckBox x:Name="ChkForceClose" Content="Allow force close after timeout"/>
                    </StackPanel>
                </GroupBox>

                <!-- Appearance -->
                <GroupBox Header="Appearance">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#DDDDDD"/>
                        <ComboBox x:Name="CmbTheme" Width="140" Padding="6,4">
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <!-- Desktop Shortcuts -->
                <GroupBox Header="Desktop Shortcuts">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCreateShortcuts"
                                Content="Create Desktop Shortcuts"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnCreateShortcuts_Click"/>
                        <TextBlock x:Name="TxtShortcutsStatus"
                                   VerticalAlignment="Center"
                                   Foreground="#4CC2FF"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Save Button -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="BtnSave"
                    Content="Save and Close"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
