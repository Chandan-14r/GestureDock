<Window x:Class="GestureDock.UI.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestureDock Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="1">

    <Window.Resources>
        <!-- Modern Fluent Tooltip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F018181C"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dock Pill Button Style -->
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Floating Acrylic Capsule Container with Specular Glass Rim -->
        <Border x:Name="CapsuleBorder"
                Background="#E61A1B22"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="6,4">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CapsuleTransform" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Color="#000000"
                                  Opacity="0.65"
                                  ShadowDepth="5"
                                  Direction="270"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- 0. Drag Grip Handle with Hand Icon -->
                <Border x:Name="GripHandle"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="Drag to reposition capsule anywhere • Double-click to reset"
                        Padding="7,6"
                        Margin="2,0,2,0"
                        CornerRadius="10"
                        PreviewMouseLeftButtonDown="GripHandle_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="GripHandle_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="GripHandle_PreviewMouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0.65"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Hand / Drag Icon -->
                        <Path Fill="#D8FFFFFF"
                              Width="14"
                              Height="15"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Data="M18.5,10.5C18.5,9.67 17.83,9 17,9C16.86,9 16.73,9.03 16.61,9.07C16.38,8.45 15.79,8 15.1,8C14.9,8 14.71,8.04 14.54,8.12C14.31,7.46 13.68,7 12.95,7C12.8,7 12.65,7.03 12.5,7.07V3.5C12.5,2.67 11.83,2 11,2C10.17,2 9.5,2.67 9.5,3.5V11.23C8.94,10.97 8.32,10.87 7.74,11.05C6.91,11.31 6.32,12.06 6.22,12.93C6.16,13.43 6.33,13.93 6.69,14.29L10.74,18.34C11.68,19.28 12.96,19.81 14.29,19.81H16.29C18.61,19.81 20.5,17.92 20.5,15.6V12.5C20.5,11.67 19.83,11 19,11C18.86,11 18.73,11.03 18.61,11.07V10.5M18.5,12.5V15.6C18.5,16.82 17.51,17.81 16.29,17.81H14.29C13.49,17.81 12.72,17.49 12.16,16.93L8.1,12.88C8.07,12.85 8.05,12.81 8.06,12.77C8.07,12.7 8.12,12.65 8.19,12.63C8.42,12.56 8.67,12.63 8.86,12.78L10.5,14.42V3.5C10.5,3.22 10.72,3 11,3C11.28,3 11.5,3.22 11.5,3.5V10.5H12.95C13.23,10.5 13.45,10.72 13.45,11V11.5H14.5V11C14.5,10.72 14.72,10.5 15,10.5C15.28,10.5 15.5,10.72 15.5,11V12H16.55V11.5C16.55,11.22 16.77,11 17.05,11C17.33,11 17.55,11.22 17.55,11.5V12.5H18.5Z"/>
                        <!-- 6 Grip Dots -->
                        <Canvas Width="5" Height="14" Margin="3,0,0,0">
                            <Ellipse Fill="#80FFFFFF" Width="2" Height="2" Canvas.Left="0" Canvas.Top="2"/>
                            <Ellipse Fill="#80FFFFFF" Width="2" Height="2" Canvas.Left="3" Canvas.Top="2"/>
                            <Ellipse Fill="#80FFFFFF" Width="2" Height="2" Canvas.Left="0" Canvas.Top="6"/>
                            <Ellipse Fill="#80FFFFFF" Width="2" Height="2" Canvas.Left="3" Canvas.Top="6"/>
                            <Ellipse Fill="#80FFFFFF" Width="2" Height="2" Canvas.Left="0" Canvas.Top="10"/>
                            <Ellipse Fill="#80FFFFFF" Width="2" Height="2" Canvas.Left="3" Canvas.Top="10"/>
                        </Canvas>
                    </StackPanel>
                </Border>

                <!-- Vertical Divider -->
                <Rectangle Width="1"
                           Height="22"
                           Fill="#20FFFFFF"
                           Margin="2,0"
                           VerticalAlignment="Center"/>

                <!-- 1. Home Button -->
                <Button x:Name="BtnHome"
                        Style="{StaticResource DockButtonStyle}"
                        ToolTip="Show Desktop (Minimize all windows)"
                        Click="BtnHome_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="#38B6FF"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0"
                              Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z"/>
                        <TextBlock Text="Home"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFF"/>
                    </StackPanel>
                </Button>

                <!-- Vertical Divider -->
                <Rectangle Width="1"
                           Height="22"
                           Fill="#20FFFFFF"
                           Margin="2,0"
                           VerticalAlignment="Center"/>

                <!-- 2. Clear All Button (Instant Close All at once) -->
                <Button x:Name="BtnClearAll"
                        Style="{StaticResource DockButtonStyle}"
                        ToolTip="Clear All (Instantly close all open applications without confirmation)"
                        Click="BtnClearAll_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="#FF4757"
                              Width="17"
                              Height="17"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0"
                              Data="M7,2H17L13,10H18L8,22L10,13H6L7,2Z"/>
                        <TextBlock Text="Clear All"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFF"/>
                    </StackPanel>
                </Button>

                <!-- Vertical Divider -->
                <Rectangle Width="1"
                           Height="22"
                           Fill="#20FFFFFF"
                           Margin="2,0"
                           VerticalAlignment="Center"/>

                <!-- 3. Close All Button (Selective Dialog) -->
                <Button x:Name="BtnCloseAll"
                        Style="{StaticResource DockButtonStyle}"
                        ToolTip="Select &amp; Close (Choose specific applications to close)"
                        Click="BtnCloseAll_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="#FFA502"
                              Width="17"
                              Height="17"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0"
                              Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,8.41L15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41Z"/>
                        <TextBlock Text="Select &amp; Close"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#DDFFFFFF"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
