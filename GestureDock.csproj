<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icons\GestureDock.ico</ApplicationIcon>
    <RootNamespace>GestureDock</RootNamespace>
    <AssemblyName>GestureDock</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>GestureDock Team</Authors>
    <Description>Windows 11 Native Task View Companion Utility</Description>
  </PropertyGroup>

</Project>
